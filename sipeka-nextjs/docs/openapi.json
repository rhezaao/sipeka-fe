  "components": {
    "schemas": {
      "Metadata": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "1.0"
          },
          "currency": {
            "type": "string",
            "const": "IDR"
          },
          "timezone": {
            "type": "string",
            "const": "Asia/Jakarta"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "defaultPeriod": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "periods": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            }
          },
          "actors": {
            "type": "object",
            "properties": {
              "company": {
                "type": "string"
              },
              "bpjs": {
                "type": "string"
              }
            },
            "required": [
              "company",
              "bpjs"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "currency",
          "timezone",
          "updatedAt",
          "defaultPeriod",
          "periods",
          "actors"
        ]
      },
      "Company": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Worker": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "initials": {
            "type": "string"
          },
          "companyId": {
            "type": "string",
            "minLength": 1
          },
          "employmentStartDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "membershipStatus": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "UNKNOWN"
            ]
          },
          "scenario": {
            "type": "string",
            "enum": [
              "real",
              "normal",
              "delay",
              "missing"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "initials",
          "companyId",
          "employmentStartDate",
          "membershipStatus",
          "scenario"
        ]
      },
      "MonthlyCheck": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "workerId": {
            "type": "string"
          },
          "companyId": {
            "type": "string"
          },
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "status": {
            "type": "string",
            "enum": [
              "MATCHED",
              "NEEDS_REVIEW",
              "DATA_UNAVAILABLE"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "declaredCompanyId": {
            "type": "string"
          },
          "registeredCompanyId": {
            "type": [
              "string",
              "null"
            ]
          },
          "declaredStartDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "registeredStartDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "wageComponent": {
            "type": "string",
            "const": "FIXED_MONTHLY_WAGE"
          },
          "comparableWage": {
            "type": "boolean"
          },
          "declaredWage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reportedWage": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "workerDeduction": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "paymentStatus": {
            "type": "string",
            "enum": [
